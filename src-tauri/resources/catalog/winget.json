        "ko": "패키지 소스 색인 새로 고침"
      },
      "keywords": {
        "zh-Hant": "來源 更新 索引",
        "ja": "ソース 更新 インデックス",
        "en": "source update index refresh",
        "fr": "source mettre à jour index",
        "de": "quelle aktualisieren index",
        "ko": "소스 업데이트 색인"
