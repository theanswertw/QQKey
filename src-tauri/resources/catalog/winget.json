      "description": {
        "zh-Hant": "安裝套件",
        "ja": "パッケージをインストール",
        "en": "Install a package",
        "fr": "Installer un paquet",
        "de": "Paket installieren",
        "ko": "패키지 설치"
      },
      "keywords": {
