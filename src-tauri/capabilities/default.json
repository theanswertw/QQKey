{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "候選框與設定視窗的預設權限",
  "windows": ["launcher", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "global-shortcut:default",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
